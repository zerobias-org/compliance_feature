{
  "name": "@zerobias-org/compliance_feature-zerobias-{code}",
  "version": "1.0.0",
  "description": "{name} compliance feature artifact.",
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/compliance_feature.git",
    "directory": "package/zerobias/{code}/"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org"
  },
  "files": [
    "elements.yml",
    "index.yml",
    "npm-shrinkwrap.json"
  ],
  "dependencies": {
    "@auditlogic/vendor-zerobias": "*"
  },
  "type": "module",
  "zerobias": {
    "dataloader-version": "1.0.0",
    "import-artifact": "compliance_feature",
    "package": "zerobias.{code}.compliance_feature",
    "orgId": "{target-org-uuid}"
  }
}
